!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test results / coverage
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Build server / publish output
[Pp]ublish/
*.publishsettings
*.azurePubxml

# OS
Thumbs.db
.DS_Store

# Misc
*.tmp
*.log
*.bak
